    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"organization\": {\n      \"type\": \"string\",\n      \"description\": \"اسم الجهة أو المؤسسة المرسلة، أو اسم الشخص إذا كان فرداً\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"مؤسسة حقوق المرأة\",\n        \"جمعية خيرية\",\n        \"مؤسسة شبابية\",\n        \"جهة حكومية\",\n        \"شركة / مورد\",\n        \"شكوى مواطن\",\n        \"طلب خدمة بلدية\",\n        \"أخرى\"\n      ]\n    },\n    \"contact_person\": {\n      \"type\": \"string\"\n    },\n    \"phone\": {\n      \"type\": \"string\"\n    },\n    \"email\": {\n      \"type\": \"string\"\n    },\n    \"request_type\": {\n      \"type\": \"string\",\n      \"description\": \"نوع الطلب باختصار: طلب دعم، دعوة لفعالية، شكوى، استفسار، شراكة...\"\n    },\n    \"location\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"عالية\",\n        \"متوسطة\",\n        \"منخفضة\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"ملخص من جملة أو جملتين بالعربية\"\n    }\n  },\n  \"required\": [\n    \"organization\",\n    \"category\",\n    \"request_type\",\n    \"priority\",\n    \"summary\"\n  ]\n}"
      },
      "id": "c347ec45-08d5-483f-b941-1d1a44a31601",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1060,
        380
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// يدمج بيانات الرسالة الأصلية مع ما استخرجه الذكاء الاصطناعي في صف واحد\nconst CATEGORIES = [\"مؤسسة حقوق المرأة\", \"جمعية خيرية\", \"مؤسسة شبابية\", \"جهة حكومية\", \"شركة / مورد\", \"شكوى مواطن\", \"طلب خدمة بلدية\", \"أخرى\"];\nconst src = $('Unified Input').item.json;\nconst ai = $json.output || {};\nconst category = CATEGORIES.includes(ai.category) ? ai.category : 'أخرى';\n\nreturn {\n  json: {\n    'التاريخ': src.received_at,\n    'المصدر': src.source === 'email' ? 'إيميل' : 'تلجرام',\n    'الجهة المرسلة': ai.organization || src.sender_name,\n    'التصنيف': category,\n    'اسم المرسل': ai.contact_person || src.sender_name,\n    'وسيلة التواصل': src.sender_contact,\n    'رقم الهاتف': ai.phone || '',\n    'البريد الإلكتروني': ai.email || (src.source === 'email' ? src.sender_contact : ''),\n    'نوع الطلب': ai.request_type || '',\n    'الموقع': ai.location || '',\n    'الأولوية': ai.priority || 'متوسطة',\n    'الملخص': ai.summary || '',\n    'الموضوع': src.subject,\n    'نص الرسالة': src.message,\n  },\n};\n"
      },
